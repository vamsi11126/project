MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
DB_NAME=campustoolkit
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGIN_REGEX=
ADMIN_PASSCODE=replace-with-admin-passcode
OTP_DEBUG_MODE=true
OTP_TTL_MINUTES=10
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX_REQUESTS=3
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_USE_TLS=true
GMAIL_API_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_API_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_API_REFRESH_TOKEN=your-google-oauth-refresh-token
GMAIL_API_FROM_EMAIL=yourname@gmail.com
GMAIL_API_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_API_SEND_URL=https://gmail.googleapis.com/gmail/v1/users/me/messages/send
COLLEGE_EMAIL_DOMAIN=example.edu
ADMIN_SESSION_COOKIE_NAME=admin_session
ADMIN_SESSION_COOKIE_SECURE=false
ADMIN_SESSION_COOKIE_SAMESITE=lax
ADMIN_SESSION_DURATION_HOURS=8
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
